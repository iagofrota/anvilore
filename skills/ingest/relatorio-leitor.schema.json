{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anvilore/relatorio-leitor/v1",
  "title": "Relatório do leitor da ingestão",
  "description": "O que o leitor devolve antes da parada humana. Caminhos de página são relativos à wiki.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "fonte", "takeaways", "paginas", "lacunas", "contradicoes"],
  "properties": {
    "versao": {
      "description": "Versão deste esquema.",
      "type": "integer",
      "enum": [1]
    },
    "fonte": {
      "description": "Caminho da fonte a partir da raiz do projeto, sempre em raw/.",
      "type": "string",
      "minLength": 1
    },
    "takeaways": {
      "description": "De 3 a 5 pontos principais, cada um sustentado por um trecho literal da fonte.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["texto", "citacao", "certeza"],
        "properties": {
          "texto": { "description": "O ponto, em uma frase.", "type": "string", "minLength": 1 },
          "citacao": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trecho", "secao"],
            "properties": {
              "trecho": { "description": "Trecho copiado da fonte, sem mudar uma palavra.", "type": "string", "minLength": 1 },
              "secao": { "description": "Onde o trecho está: título da seção, página ou minuto.", "type": "string", "minLength": 1 }
            }
          },
          "certeza": {
            "description": "O grau que a própria fonte dá ao ponto. Nunca promova: provável na fonte não vira comprovado.",
            "type": "string",
            "enum": ["comprovado", "provavel", "inferencia"]
          }
        }
      }
    },
    "paginas": {
      "description": "Páginas da wiki que a fonte toca. Exatamente uma do tipo source.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caminho", "tipo", "acao", "motivo"],
        "properties": {
          "caminho": { "description": "Relativo à wiki: <área>/<tipo>/<slug>.md ou <tipo>/<slug>.md.", "type": "string", "minLength": 1 },
          "tipo": { "type": "string", "enum": ["source", "entity", "concept"] },
          "acao": { "type": "string", "enum": ["criar", "atualizar"] },
          "motivo": { "description": "Por que a página entra, em uma frase.", "type": "string", "minLength": 1 }
        }
      }
    },
    "lacunas": {
      "description": "O que a fonte deixa sem resposta.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contradicoes": {
      "description": "Onde a fonte contradiz uma página existente. Registre; não resolva.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pagina", "descricao"],
        "properties": {
          "pagina": { "description": "Caminho da página existente, relativo à wiki.", "type": "string", "minLength": 1 },
          "descricao": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
