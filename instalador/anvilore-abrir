#!/usr/bin/env bash
# Lançador do Anvilore para Linux. Pode morar no kit, em ~/.local/bin ou no pacote.
set -u

PASTA="${ANVILORE_PASTA:-${HOME:?HOME não definido}/Anvilore}"
ARQUIVO_LANCADOR="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
ORIGEM="$(cd -- "$(dirname -- "$ARQUIVO_LANCADOR")" 2>/dev/null && pwd -P)"

instalacao_valida() {
  [ -d "$1/.git" ] && [ -f "$1/AGENTS.md" ] && [ -f "$1/src/cli.ts" ] && [ -d "$1/skills" ]
}

mostrar_erro_e_esperar() {
  printf '%s\n' "$@" >&2
  if [ -t 0 ]; then
    printf 'Pressione Enter para fechar esta janela. ' >&2
    IFS= read -r _ || true
  fi
}

if ! instalacao_valida "$PASTA"; then
  INSTALADOR=""
  if [ -f "$ORIGEM/instalar.sh" ]; then INSTALADOR="$ORIGEM/instalar.sh"
  elif [ -f /usr/lib/anvilore/instalar.sh ]; then INSTALADOR=/usr/lib/anvilore/instalar.sh
  elif [ -f "$PASTA/instalador/instalar.sh" ]; then INSTALADOR="$PASTA/instalador/instalar.sh"
  fi
  if [ -n "$INSTALADOR" ]; then
    ANVILORE_PASTA="$PASTA" bash "$INSTALADOR"
    CODIGO_INSTALADOR=$?
    if [ "$CODIGO_INSTALADOR" -ne 0 ]; then
      mostrar_erro_e_esperar "A instalação do Anvilore falhou (código $CODIGO_INSTALADOR)."
      exit "$CODIGO_INSTALADOR"
    fi
  else
    mostrar_erro_e_esperar "O Anvilore ainda não está instalado em $PASTA." "Instale pelo instalador Linux do Anvilore e abra este atalho de novo."
    exit 1
  fi
  if ! instalacao_valida "$PASTA"; then
    mostrar_erro_e_esperar "A instalação não foi concluída em $PASTA. Rode o instalador Linux e tente de novo."
    exit 1
  fi
fi

export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

encontrar_bun() {
  local candidato registro shell_login
  candidato="$(command -v bun 2>/dev/null || true)"
  if [[ "$candidato" != /* && -n "$candidato" ]]; then candidato="$(readlink -f -- "$candidato" 2>/dev/null || true)"; fi
  if [[ "$candidato" = /* && -x "$candidato" ]]; then BUN_BIN="$candidato"; return 0; fi

  candidato="$HOME/.bun/bin/bun"
  if [ -x "$candidato" ]; then BUN_BIN="$candidato"; return 0; fi

  registro="${XDG_CONFIG_HOME:-$HOME/.config}/anvilore/bun-path"
  if [ -f "$registro" ] && [ ! -L "$registro" ] && [ -O "$registro" ]; then
    IFS= read -r candidato <"$registro" || candidato=""
    if [[ "$candidato" = /* && -x "$candidato" && -O "$candidato" ]]; then BUN_BIN="$candidato"; return 0; fi
  fi

  shell_login="${SHELL:-}"
  if [[ "$shell_login" = /* && -x "$shell_login" ]] && command -v timeout >/dev/null 2>&1; then
    candidato="$(timeout 3 "$shell_login" -lic 'command -v bun' 2>/dev/null || true)"
    if [[ "$candidato" = /* && -x "$candidato" ]]; then BUN_BIN="$candidato"; return 0; fi
  fi
  return 1
}

if ! encontrar_bun; then
  mostrar_erro_e_esperar "Bun não encontrado. Instale com 'npm install -g bun' ou siga https://bun.sh e abra o Anvilore novamente."
  exit 2
fi

versao_numerica_valida() {
  [[ "$1" =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]]
}

versao_maior() {
  local -a pacote instalada
  local i
  IFS=. read -r -a pacote <<<"$1"
  IFS=. read -r -a instalada <<<"$2"
  for i in 0 1 2; do
    [ "${pacote[$i]}" -gt "${instalada[$i]}" ] && return 0
    [ "${pacote[$i]}" -lt "${instalada[$i]}" ] && return 1
  done
  return 1
}

versao_pelo_menos() {
  [ "$1" = "$2" ] || versao_maior "$1" "$2"
}

versao_instalada() {
  local versao
  versao="$(sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^\"]+)"[,]?[[:space:]]*$/\1/p' "$PASTA/package.json" 2>/dev/null | head -n1)"
  versao_numerica_valida "$versao" || return 1
  printf '%s' "$versao"
}

atualizar_kit_do_pacote() {
  local arquivo_versao="$ORIGEM/VERSAO" versao_pacote versao_atual versao_original instalador codigo
  [ -f "$arquivo_versao" ] || return 0
  IFS= read -r versao_pacote <"$arquivo_versao" || return 0
  versao_numerica_valida "$versao_pacote" || return 0
  versao_atual="$(versao_instalada || true)"
  versao_numerica_valida "$versao_atual" || return 0
  versao_maior "$versao_pacote" "$versao_atual" || return 0
  versao_original="$versao_atual"

  instalador="$ORIGEM/instalar.sh"
  if [ ! -f "$instalador" ]; then
    printf 'Não consegui atualizar o Anvilore de %s para %s: o instalador do pacote não está disponível. Vou abrir a versão existente.\n' "$versao_atual" "$versao_pacote" >&2
    return 0
  fi
  printf 'Atualizando o Anvilore de %s para %s…\n' "$versao_atual" "$versao_pacote"
  ANVILORE_PASTA="$PASTA" ANVILORE_SEM_PERGUNTAS=1 bash "$instalador"
  codigo=$?
  versao_atual="$(versao_instalada || true)"
  if [ "$codigo" -ne 0 ] || ! versao_numerica_valida "$versao_atual" || ! versao_pelo_menos "$versao_atual" "$versao_pacote"; then
    printf 'Não consegui atualizar o Anvilore de %s para %s. Vou abrir a versão existente.\n' "$versao_original" "$versao_pacote" >&2
  fi
}

atualizar_kit_do_pacote

cd -- "$PASTA" || { mostrar_erro_e_esperar "Não consegui abrir a pasta $PASTA."; exit 1; }
ANVILORE_DESTINO="$PASTA" "$BUN_BIN" src/cli.ts ui
CODIGO=$?
if [ "$CODIGO" -ne 0 ]; then
  mostrar_erro_e_esperar "" "A interface do Anvilore fechou com erro (código $CODIGO). Confira a mensagem acima."
fi
exit "$CODIGO"
