#!/usr/bin/env bash
# Lançador do Anvilore para Linux. Pode morar no kit, em ~/.local/bin ou no pacote.
set -u

PASTA="${ANVILORE_PASTA:-${HOME:?HOME não definido}/Anvilore}"
ARQUIVO_LANCADOR="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
ORIGEM="$(cd -- "$(dirname -- "$ARQUIVO_LANCADOR")" 2>/dev/null && pwd -P)"

instalacao_valida() {
  [ -d "$1/.git" ] && [ -f "$1/AGENTS.md" ] && [ -f "$1/src/cli.ts" ] && [ -d "$1/skills" ]
}

obter_ou_preparar_arquivo_log() {
  local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/anvilore"
  local log_file="$log_dir/abrir.log"
  if [ -L "$log_dir" ] || [ -L "$log_file" ]; then return 1; fi
  if [ -e "$log_dir" ] && [ ! -O "$log_dir" ]; then return 1; fi
  if [ -e "$log_file" ] && [ ! -O "$log_file" ]; then return 1; fi
  (
    umask 077
    mkdir -p -m 700 "$log_dir" 2>/dev/null || true
    touch "$log_file" 2>/dev/null || true
  ) 2>/dev/null || true
  chmod 700 "$log_dir" 2>/dev/null || true
  chmod 600 "$log_file" 2>/dev/null || true
  if [ -f "$log_file" ] && [ -O "$log_file" ] && [ ! -L "$log_file" ]; then
    printf '%s' "$log_file"
    return 0
  fi
  return 1
}

registrar_abrir_log() {
  local mensagem="$1" log_file
  log_file="$(obter_ou_preparar_arquivo_log 2>/dev/null || true)"
  [ -n "$log_file" ] || return 0
  (
    umask 077
    local carimbo msg
    carimbo="$(date --iso-8601=seconds 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)"
    msg="$(printf '%s\n' "$mensagem" | sed -E 's/token=[a-zA-Z0-9_-]+/token=[REDUZIDO]/g')"
    printf '%s %s\n' "$carimbo" "$msg" >>"$log_file"
  ) 2>/dev/null || true
  chmod 600 "$log_file" 2>/dev/null || true
}

gravar_log_erro() {
  registrar_abrir_log "$*"
}

montar_mensagem_erro_servidor() {
  local codigo="$1" log_file="$2"
  local ultimas_linhas=""
  if [ -n "$log_file" ] && [ -f "$log_file" ]; then
    ultimas_linhas="$(tail -n 10 "$log_file" 2>/dev/null | sed -E 's/token=[a-zA-Z0-9_-]+/token=[REDUZIDO]/g')"
  fi

  local corpo="A interface do Anvilore fechou com erro (código $codigo)."
  if [ -n "$ultimas_linhas" ]; then
    corpo="$corpo"$'\n\n'"Últimas linhas do erro:"$'\n'"$ultimas_linhas"
  fi
  if [ -n "$log_file" ] && [ -f "$log_file" ] && [ "$log_file" != "/dev/null" ]; then
    corpo="$corpo"$'\n\n'"Registro completo em: $log_file"
  fi
  printf '%s' "$corpo"
}

mostrar_erro_e_esperar() {
  local msg="$*"
  [ -n "$msg" ] && gravar_log_erro "$msg"
  printf '%s\n' "$@" >&2

  if [ -t 0 ]; then
    printf 'Pressione Enter para fechar esta janela. ' >&2
    IFS= read -r _ || true
    return 0
  fi

  local texto
  texto="$(printf '%s\n' "$@" | sed -e '/./,$!d')"
  [ -n "$texto" ] || return 0

  # Se estiver em ambiente com diálogos suprimidos, não bloqueia com diálogo modal
  if [ -n "${ANVILORE_SEM_DIALOGO:-}" ]; then
    [ -n "${ANVILORE_TEST_DIALOGO:-}" ] || return 0
  fi

  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --title="Anvilore" --text="$texto" 2>/dev/null && return 0
    fi
    if command -v kdialog >/dev/null 2>&1; then
      kdialog --error "$texto" --title "Anvilore" 2>/dev/null && return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -u critical "Anvilore" "$texto" 2>/dev/null && return 0
    fi
  fi

  local emuladores=("x-terminal-emulator" "gnome-terminal" "ptyxis" "kgx" "konsole" "xfce4-terminal" "xterm")
  local emu bin
  for emu in "${emuladores[@]}"; do
    bin="$(command -v "$emu" 2>/dev/null || true)"
    if [ -n "$bin" ] && [ -x "$bin" ]; then
      case "$emu" in
        gnome-terminal|ptyxis|kgx)
          "$bin" -- bash -c 'printf "%s\n\nPressione Enter para fechar esta janela. " "$1"; read -r _' _ "$texto" 2>/dev/null && return 0
          ;;
        xfce4-terminal)
          "$bin" -x bash -c 'printf "%s\n\nPressione Enter para fechar esta janela. " "$1"; read -r _' _ "$texto" 2>/dev/null && return 0
          ;;
        konsole|xterm|x-terminal-emulator|*)
          "$bin" -e bash -c 'printf "%s\n\nPressione Enter para fechar esta janela. " "$1"; read -r _' _ "$texto" 2>/dev/null && return 0
          ;;
      esac
    fi
  done
  return 0
}

abrir_no_terminal() {
  local emuladores=("x-terminal-emulator" "gnome-terminal" "ptyxis" "kgx" "konsole" "xfce4-terminal" "xterm")
  local emu bin
  for emu in "${emuladores[@]}"; do
    bin="$(command -v "$emu" 2>/dev/null || true)"
    if [ -n "$bin" ] && [ -x "$bin" ]; then
      case "$emu" in
        gnome-terminal|ptyxis|kgx)
          exec "$bin" -- env ANVILORE_EM_TERMINAL=1 ANVILORE_PASTA="$PASTA" bash "$ARQUIVO_LANCADOR" "$@"
          ;;
        xfce4-terminal)
          exec "$bin" -x env ANVILORE_EM_TERMINAL=1 ANVILORE_PASTA="$PASTA" bash "$ARQUIVO_LANCADOR" "$@"
          ;;
        konsole|xterm|x-terminal-emulator|*)
          exec "$bin" -e env ANVILORE_EM_TERMINAL=1 ANVILORE_PASTA="$PASTA" bash "$ARQUIVO_LANCADOR" "$@"
          ;;
      esac
    fi
  done
  return 1
}

if ! instalacao_valida "$PASTA"; then
  INSTALADOR=""
  if [ -f "$ORIGEM/instalar.sh" ]; then INSTALADOR="$ORIGEM/instalar.sh"
  elif [ -f "${ANVILORE_PACKAGE_DIR:-/usr/lib/anvilore}/instalar.sh" ]; then INSTALADOR="${ANVILORE_PACKAGE_DIR:-/usr/lib/anvilore}/instalar.sh"
  elif [ -f "$PASTA/instalador/instalar.sh" ]; then INSTALADOR="$PASTA/instalador/instalar.sh"
  fi

  if [ -n "$INSTALADOR" ]; then
    if ! { [ -t 0 ] || [ -t 1 ]; } && [ -z "${ANVILORE_EM_TERMINAL:-}" ]; then
      if [ -z "${ANVILORE_SEM_DIALOGO:-}" ] || [ -n "${ANVILORE_TEST_DIALOGO:-}" ]; then
        abrir_no_terminal "$@" || true
      fi
    fi
    ANVILORE_PASTA="$PASTA" bash "$INSTALADOR"
    CODIGO_INSTALADOR=$?
    if [ "$CODIGO_INSTALADOR" -ne 0 ]; then
      mostrar_erro_e_esperar "A instalação do Anvilore falhou (código $CODIGO_INSTALADOR)."
      exit "$CODIGO_INSTALADOR"
    fi
  else
    mostrar_erro_e_esperar "O Anvilore ainda não está instalado em $PASTA." "Instale pelo instalador Linux do Anvilore e abra este atalho de novo."
    exit 1
  fi
  if ! instalacao_valida "$PASTA"; then
    mostrar_erro_e_esperar "A instalação não foi concluída em $PASTA. Rode o instalador Linux e tente de novo."
    exit 1
  fi

  # P2-5: depois da 1ª instalação no terminal, relançar desacoplado e fechar o terminal
  if [ -n "${ANVILORE_EM_TERMINAL:-}" ]; then
    printf 'Pronto, abrindo no navegador…\n'
    if command -v setsid >/dev/null 2>&1; then
      setsid env ANVILORE_DESACOPLADO=1 ANVILORE_PASTA="$PASTA" bash "$ARQUIVO_LANCADOR" "$@" </dev/null >/dev/null 2>&1 &
    elif command -v nohup >/dev/null 2>&1; then
      nohup env ANVILORE_DESACOPLADO=1 ANVILORE_PASTA="$PASTA" bash "$ARQUIVO_LANCADOR" "$@" </dev/null >/dev/null 2>&1 &
    else
      env ANVILORE_DESACOPLADO=1 ANVILORE_PASTA="$PASTA" bash "$ARQUIVO_LANCADOR" "$@" </dev/null >/dev/null 2>&1 &
    fi
    exit 0
  fi
fi

export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

registrar_bun() {
  local bun_caminho="$1" diretorio destino arquivo_temporario
  [ -n "$bun_caminho" ] || return 0
  diretorio="${XDG_CONFIG_HOME:-$HOME/.config}/anvilore"
  destino="$diretorio/bun-path"
  if [ -L "$diretorio" ] || [ -L "$destino" ]; then return 0; fi
  if [ -e "$diretorio" ] && [ ! -O "$diretorio" ]; then return 0; fi
  if [ -e "$destino" ] && [ ! -O "$destino" ]; then return 0; fi
  mkdir -p "$diretorio" 2>/dev/null || return 0
  arquivo_temporario="$(mktemp "$diretorio/.bun-path.XXXXXX" 2>/dev/null)" || return 0
  if (umask 077; printf '%s\n' "$bun_caminho" >"$arquivo_temporario") && chmod 600 "$arquivo_temporario" && mv -f -- "$arquivo_temporario" "$destino"; then
    :
  else
    rm -f -- "$arquivo_temporario"
  fi
}

resolver_nvm_diretorio() {
  local alvo="$1" visitados="${2:-}"
  local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  [ -n "$alvo" ] || return 1
  [[ " $visitados " =~ " $alvo " ]] && return 1
  visitados="$visitados $alvo"

  if [ -d "$nvm_dir/versions/node/$alvo" ]; then
    printf '%s' "$nvm_dir/versions/node/$alvo"
    return 0
  fi
  if [ -d "$nvm_dir/versions/node/v$alvo" ]; then
    printf '%s' "$nvm_dir/versions/node/v$alvo"
    return 0
  fi
  if [ -d "$alvo" ]; then
    printf '%s' "$alvo"
    return 0
  fi
  if [ -f "$nvm_dir/alias/$alvo" ]; then
    local proximo
    proximo="$(tr -d '[:space:]' <"$nvm_dir/alias/$alvo" 2>/dev/null || true)"
    resolver_nvm_diretorio "$proximo" "$visitados" && return 0
  fi
  return 1
}

encontrar_bun_nvm() {
  local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  [ -d "$nvm_dir/versions/node" ] || return 1

  local padrao dir_padrao candidato
  if [ -f "$nvm_dir/alias/default" ]; then
    padrao="$(tr -d '[:space:]' <"$nvm_dir/alias/default" 2>/dev/null || true)"
    dir_padrao="$(resolver_nvm_diretorio "$padrao" || true)"
    if [ -n "$dir_padrao" ] && [ -d "$dir_padrao" ]; then
      candidato="$dir_padrao/bin/bun"
      if [[ "$candidato" = /* && -x "$candidato" && -O "$candidato" ]]; then
        printf '%s' "$candidato"
        return 0
      fi
    fi
  fi

  local -a candidatos=()
  local dir c
  for dir in "$nvm_dir/versions/node/"*/; do
    [ -d "$dir" ] || continue
    c="${dir}bin/bun"
    if [[ "$c" = /* && -x "$c" && -O "$c" ]]; then
      candidatos+=("$c")
    fi
  done

  if [ ${#candidatos[@]} -gt 0 ]; then
    printf '%s\n' "${candidatos[@]}" | sort -V 2>/dev/null | tail -n1
    return 0
  fi

  return 1
}

encontrar_bun() {
  local candidato registro shell_login
  candidato="$(command -v bun 2>/dev/null || true)"
  if [[ "$candidato" != /* && -n "$candidato" ]]; then candidato="$(readlink -f -- "$candidato" 2>/dev/null || true)"; fi
  if [[ "$candidato" = /* && -x "$candidato" ]]; then BUN_BIN="$candidato"; return 0; fi

  candidato="$HOME/.bun/bin/bun"
  if [ -x "$candidato" ]; then BUN_BIN="$candidato"; return 0; fi

  registro="${XDG_CONFIG_HOME:-$HOME/.config}/anvilore/bun-path"
  if [ -f "$registro" ] && [ ! -L "$registro" ] && [ -O "$registro" ]; then
    IFS= read -r candidato <"$registro" || candidato=""
    if [[ "$candidato" = /* && -x "$candidato" && -O "$candidato" ]]; then BUN_BIN="$candidato"; return 0; fi
  fi

  candidato="$(encontrar_bun_nvm || true)"
  if [[ "$candidato" = /* && -x "$candidato" && -O "$candidato" ]]; then
    BUN_BIN="$candidato"
    registrar_bun "$candidato"
    return 0
  fi

  shell_login="${SHELL:-}"
  if [[ "$shell_login" = /* && -x "$shell_login" ]] && command -v timeout >/dev/null 2>&1; then
    candidato="$(timeout 10 "$shell_login" -lic 'command -v bun' 2>/dev/null || true)"
    if [[ "$candidato" != /* && -n "$candidato" ]]; then candidato="$(readlink -f -- "$candidato" 2>/dev/null || true)"; fi
    if [[ "$candidato" = /* && -x "$candidato" && -O "$candidato" ]]; then
      BUN_BIN="$candidato"
      registrar_bun "$candidato"
      return 0
    fi
  fi
  return 1
}

if ! encontrar_bun; then
  mostrar_erro_e_esperar "Bun não encontrado. Instale com 'npm install -g bun' ou siga https://bun.sh e abra o Anvilore novamente."
  exit 2
fi

versao_numerica_valida() {
  [[ "$1" =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]]
}

versao_maior() {
  local -a pacote instalada
  local i
  IFS=. read -r -a pacote <<<"$1"
  IFS=. read -r -a instalada <<<"$2"
  for i in 0 1 2; do
    [ "${pacote[$i]}" -gt "${instalada[$i]}" ] && return 0
    [ "${pacote[$i]}" -lt "${instalada[$i]}" ] && return 1
  done
  return 1
}

versao_pelo_menos() {
  [ "$1" = "$2" ] || versao_maior "$1" "$2"
}

versao_instalada() {
  local versao
  versao="$(sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^\"]+)"[,]?[[:space:]]*$/\1/p' "$PASTA/package.json" 2>/dev/null | head -n1)"
  versao_numerica_valida "$versao" || return 1
  printf '%s' "$versao"
}

gravar_versao_tentada() {
  local versao="$1" agora diretorio destino arquivo_temporario
  [ -n "$versao" ] || return 0
  agora="$(date +%s 2>/dev/null || echo 0)"
  diretorio="${XDG_STATE_HOME:-$HOME/.local/state}/anvilore"
  destino="$diretorio/versao-tentada"
  if [ -L "$diretorio" ] || [ -L "$destino" ]; then return 0; fi
  if [ -e "$diretorio" ] && [ ! -O "$diretorio" ]; then return 0; fi
  if [ -e "$destino" ] && [ ! -O "$destino" ]; then return 0; fi
  mkdir -p "$diretorio" 2>/dev/null || return 0
  chmod 700 "$diretorio" 2>/dev/null || true
  arquivo_temporario="$(mktemp "$diretorio/.versao-tentada.XXXXXX" 2>/dev/null)" || return 0
  if (umask 077; printf '%s %s\n' "$versao" "$agora" >"$arquivo_temporario") && chmod 600 "$arquivo_temporario" && mv -f -- "$arquivo_temporario" "$destino"; then
    :
  else
    rm -f -- "$arquivo_temporario"
  fi
}

limpar_versao_tentada() {
  local diretorio="${XDG_STATE_HOME:-$HOME/.local/state}/anvilore"
  local destino="$diretorio/versao-tentada"
  if [ -f "$destino" ] && [ ! -L "$destino" ] && [ -O "$destino" ]; then
    rm -f -- "$destino" 2>/dev/null || true
  fi
}

versao_ja_tentada() {
  local versao="$1" diretorio destino tentada gravado agora limite=86400
  diretorio="${XDG_STATE_HOME:-$HOME/.local/state}/anvilore"
  destino="$diretorio/versao-tentada"
  if [ -f "$destino" ] && [ ! -L "$destino" ] && [ -O "$destino" ]; then
    read -r tentada gravado <"$destino" 2>/dev/null || return 1
    if [ "$tentada" = "$versao" ]; then
      if [ -n "${gravado:-}" ] && [[ "$gravado" =~ ^[0-9]+$ ]]; then
        agora="$(date +%s 2>/dev/null || echo 0)"
        if [ "$agora" -ge "$gravado" ] && [ $(( agora - gravado )) -ge "$limite" ]; then
          rm -f -- "$destino" 2>/dev/null || true
          return 1
        fi
      fi
      return 0
    fi
  fi
  return 1
}

atualizar_kit_do_pacote() {
  local arquivo_versao="$ORIGEM/VERSAO" versao_pacote versao_atual versao_original instalador codigo
  [ -f "$arquivo_versao" ] || return 0
  IFS= read -r versao_pacote <"$arquivo_versao" || return 0
  versao_numerica_valida "$versao_pacote" || return 0
  versao_atual="$(versao_instalada || true)"
  versao_numerica_valida "$versao_atual" || return 0
  versao_maior "$versao_pacote" "$versao_atual" || return 0
  if versao_ja_tentada "$versao_pacote"; then
    registrar_abrir_log "atualização para $versao_pacote já tentada anteriormente; abrindo versão instalada $versao_atual"
    return 0
  fi
  versao_original="$versao_atual"

  instalador="$ORIGEM/instalar.sh"
  if [ ! -f "$instalador" ]; then
    printf 'Não consegui atualizar o Anvilore de %s para %s: o instalador do pacote não está disponível. Vou abrir a versão existente.\n' "$versao_atual" "$versao_pacote" >&2
    return 0
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Anvilore" "Atualizando o Anvilore de $versao_atual para $versao_pacote…" 2>/dev/null || true
  fi
  printf 'Atualizando o Anvilore de %s para %s…\n' "$versao_atual" "$versao_pacote"
  PATH="$(dirname "$BUN_BIN"):$PATH" ANVILORE_PASTA="$PASTA" ANVILORE_VERSAO="$versao_pacote" ANVILORE_SEM_PERGUNTAS=1 bash "$instalador"
  codigo=$?
  versao_atual="$(versao_instalada || true)"
  if [ "$codigo" -ne 0 ] || ! versao_numerica_valida "$versao_atual" || ! versao_pelo_menos "$versao_atual" "$versao_pacote"; then
    gravar_versao_tentada "$versao_pacote"
    registrar_abrir_log "atualização de $versao_original para $versao_pacote falhou (código $codigo, instalada $versao_atual)"
    printf 'Não consegui atualizar o Anvilore de %s para %s. Vou abrir a versão existente.\n' "$versao_original" "$versao_pacote" >&2
  else
    limpar_versao_tentada
    registrar_abrir_log "atualização de $versao_original para $versao_pacote concluída com sucesso"
  fi
}

obter_caminho_estado() {
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    printf '%s/anvilore-ui.json' "$XDG_RUNTIME_DIR"
  else
    local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
    printf '%s/anvilore/anvilore-ui.json' "$state_home"
  fi
}

obter_caminho_trava() {
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    printf '%s/anvilore-ui.lock' "$XDG_RUNTIME_DIR"
  else
    local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
    printf '%s/anvilore/anvilore-ui.lock' "$state_home"
  fi
}

USOU_MKDIR_LOCK=0
MKDIR_LOCK_DIR=""

travar_instancia() {
  local arquivo_trava trava_dir
  arquivo_trava="$(obter_caminho_trava)"
  trava_dir="$(dirname -- "$arquivo_trava")"

  # P3-A: arquivo de trava não pode ser symlink nem ter outro dono
  if [ -L "$trava_dir" ] || [ -L "$arquivo_trava" ]; then
    mostrar_erro_e_esperar "Trava inválida: symlink não é permitido em $arquivo_trava"
    exit 1
  fi
  if [ -e "$trava_dir" ] && [ ! -O "$trava_dir" ]; then
    mostrar_erro_e_esperar "Diretório de trava inválido: não pertence ao usuário atual ($trava_dir)"
    exit 1
  fi
  if [ -e "$arquivo_trava" ] && [ ! -O "$arquivo_trava" ]; then
    mostrar_erro_e_esperar "Arquivo de trava inválido: não pertence ao usuário atual ($arquivo_trava)"
    exit 1
  fi
  if [ -d "$arquivo_trava" ]; then
    mostrar_erro_e_esperar "Não consegui abrir a trava do Anvilore em $arquivo_trava: o arquivo de trava é um diretório."
    exit 1
  fi

  mkdir -p -m 700 "$trava_dir" 2>/dev/null || true
  chmod 700 "$trava_dir" 2>/dev/null || true

  if command -v flock >/dev/null 2>&1; then
    if ! ( : >>"$arquivo_trava" ) 2>/dev/null; then
      mostrar_erro_e_esperar "Não consegui abrir a trava do Anvilore em $arquivo_trava."
      exit 1
    fi
    exec 9>"$arquivo_trava" || {
      mostrar_erro_e_esperar "Não consegui abrir a trava do Anvilore em $arquivo_trava."
      exit 1
    }
    chmod 600 "$arquivo_trava" 2>/dev/null || true
    if ! flock -w 20 9; then
      gravar_log_erro "Trava de inicialização ocupada por mais de 20s (outro processo ainda subindo). Saindo silenciosamente."
      exit 0
    fi
  else
    # P3-A: Fallback atômico com mkdir caso flock não esteja disponível
    MKDIR_LOCK_DIR="$trava_dir/anvilore-ui.lock.d"
    local obtido=0 agora mod
    for _ in $(seq 1 200); do
      if mkdir "$MKDIR_LOCK_DIR" 2>/dev/null; then
        obtido=1
        USOU_MKDIR_LOCK=1
        trap 'liberar_trava_instancia' EXIT INT TERM
        break
      fi
      # Expira lock velho após 30 s
      agora=$(date +%s 2>/dev/null || echo 0)
      mod=$(stat -c %Y "$MKDIR_LOCK_DIR" 2>/dev/null || echo "$agora")
      if [ $((agora - mod)) -gt 30 ]; then
        rmdir "$MKDIR_LOCK_DIR" 2>/dev/null || rm -rf "$MKDIR_LOCK_DIR" 2>/dev/null || true
      fi
      sleep 0.1
    done
    if [ "$obtido" -ne 1 ]; then
      gravar_log_erro "Trava de inicialização ocupada por mais de 20s (outro processo ainda subindo via diretório). Saindo silenciosamente."
      exit 0
    fi
  fi
}

liberar_trava_instancia() {
  if [ "$USOU_MKDIR_LOCK" -eq 1 ] && [ -n "$MKDIR_LOCK_DIR" ]; then
    rmdir "$MKDIR_LOCK_DIR" 2>/dev/null || rm -rf "$MKDIR_LOCK_DIR" 2>/dev/null || true
    USOU_MKDIR_LOCK=0
  fi
  if command -v flock >/dev/null 2>&1; then
    flock -u 9 2>/dev/null || true
    exec 9>&-
  fi
}

abrir_navegador() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command -v gio >/dev/null 2>&1; then
    gio open "$url" >/dev/null 2>&1 &
  fi
}

obter_inicio_processo() {
  local pid="$1"
  if [ -f "/proc/$pid/stat" ]; then
    local stat_str
    stat_str="$(cat "/proc/$pid/stat" 2>/dev/null || true)"
    local pos_p="${stat_str##*)}"
    if [ -n "$pos_p" ]; then
      local -a campos=($pos_p)
      printf '%s' "${campos[19]:-}"
      return 0
    fi
  fi
  return 1
}

estado_pronto_para_servidor() {
  local arquivo_estado="$1" server_pid="$2" pasta_alvo="${3:-}"
  [ -f "$arquivo_estado" ] || return 1
  [ -n "$server_pid" ] || return 1

  "$BUN_BIN" -e '
    const fs = require("node:fs");
    const path = require("node:path");
    const arquivo = process.argv[1];
    const serverPid = parseInt(process.argv[2], 10);
    const pastaAlvo = process.argv[3] ? path.resolve(process.argv[3]) : undefined;
    try {
      const est = JSON.parse(fs.readFileSync(arquivo, "utf8"));
      if (typeof est.pid !== "number" || typeof est.porta !== "number" || typeof est.token !== "string" || typeof est.pasta !== "string") {
        process.exit(1);
      }
      if (est.soRevisao === true) {
        process.exit(1);
      }
      if (pastaAlvo && path.resolve(est.pasta) !== pastaAlvo) {
        process.exit(1);
      }
      if (est.pid === serverPid) {
        process.exit(0);
      }
      let atual = est.pid;
      while (atual > 1) {
        try {
          const s = fs.readFileSync("/proc/" + atual + "/stat", "utf8");
          const r = s.lastIndexOf(")");
          if (r === -1) break;
          const campos = s.slice(r + 2).trim().split(/\s+/);
          const ppid = parseInt(campos[1], 10);
          if (ppid === serverPid) process.exit(0);
          if (ppid === atual || ppid <= 1) break;
          atual = ppid;
        } catch {
          break;
        }
      }
      process.exit(1);
    } catch {
      process.exit(1);
    }
  ' "$arquivo_estado" "$server_pid" "$pasta_alvo" 2>/dev/null
}

verificar_instancia_existente() {
  local arquivo_estado
  arquivo_estado="$(obter_caminho_estado)"
  [ -e "$arquivo_estado" ] || return 1
  [ ! -L "$arquivo_estado" ] || { rm -f -- "$arquivo_estado"; return 1; }
  [ -O "$arquivo_estado" ] || return 1

  local info
  info="$("$BUN_BIN" -e '
    try {
      const fs = require("node:fs");
      const est = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      if (typeof est.pid === "number" && typeof est.porta === "number" && typeof est.token === "string" && typeof est.pasta === "string") {
        if (est.soRevisao === false) {
          console.log(`${est.pid}:${est.porta}:${est.token}:${est.inicio || ""}:${est.pasta}`);
        } else {
          console.log("INCOMPATIVEL:" + est.pid);
        }
      }
    } catch {}
  ' "$arquivo_estado" 2>/dev/null || true)"

  [ -n "$info" ] || { rm -f -- "$arquivo_estado"; return 1; }

  if [[ "$info" == INCOMPATIVEL:* ]]; then
    local pid_revisao="${info#INCOMPATIVEL:}"
    if ! kill -0 "$pid_revisao" 2>/dev/null; then
      rm -f -- "$arquivo_estado"
    fi
    return 1
  fi

  local est_pid est_porta est_token est_inicio est_pasta
  IFS=: read -r est_pid est_porta est_token est_inicio est_pasta <<<"$info"

  if ! kill -0 "$est_pid" 2>/dev/null; then
    rm -f -- "$arquivo_estado"
    return 1
  fi

  # P2-C: validação da hora de início (campo 22 de /proc/PID/stat) contra PID reaproveitado
  if [ -n "$est_inicio" ]; then
    local inicio_atual
    inicio_atual="$(obter_inicio_processo "$est_pid" || true)"
    if [ -z "$inicio_atual" ] || [ "$inicio_atual" != "$est_inicio" ]; then
      rm -f -- "$arquivo_estado"
      return 1
    fi
  fi

  local pasta_canonica pasta_est_canonica
  pasta_canonica="$(cd -- "$PASTA" 2>/dev/null && pwd -P || printf '%s' "$PASTA")"
  pasta_est_canonica="$(cd -- "$est_pasta" 2>/dev/null && pwd -P || printf '%s' "$est_pasta")"
  if [ "$pasta_canonica" != "$pasta_est_canonica" ]; then
    return 1
  fi

  local url="http://127.0.0.1:$est_porta/?token=$est_token"
  local resultado_http
  resultado_http="$("$BUN_BIN" -e '
    fetch(process.argv[1], { signal: AbortSignal.timeout(2000) })
      .then(r => console.log(r.status === 200 ? "OK" : "STATUS_" + r.status))
      .catch((err) => {
        if (err && (err.name === "TimeoutError" || err.name === "AbortError")) {
          console.log("TIMEOUT");
        } else {
          console.log("ERRO");
        }
      });
  ' "$url" 2>/dev/null || echo ERRO)"

  if [ "$resultado_http" = "OK" ]; then
    URL_EXISTENTE="$url"
    return 0
  fi

  # P2-C / P3-7: se foi estritamente TIMEOUT e o processo ainda é o mesmo e está vivo, preserva e reabre
  if [ "$resultado_http" = "TIMEOUT" ] && kill -0 "$est_pid" 2>/dev/null; then
    if [ -n "$est_inicio" ]; then
      local inicio_atual
      inicio_atual="$(obter_inicio_processo "$est_pid" || true)"
      if [ -n "$inicio_atual" ] && [ "$inicio_atual" = "$est_inicio" ]; then
        URL_EXISTENTE="$url"
        return 0
      fi
    else
      URL_EXISTENTE="$url"
      return 0
    fi
  fi

  rm -f -- "$arquivo_estado"
  return 1
}

URL_EXISTENTE=""
travar_instancia

# P3-4: checar se já existe servidor ativo ANTES de qualquer tentativa de atualização
if verificar_instancia_existente; then
  liberar_trava_instancia
  abrir_navegador "$URL_EXISTENTE"
  exit 0
fi

# Início a frio: se houver versão mais recente do pacote, atualiza o kit
atualizar_kit_do_pacote

cd -- "$PASTA" || { liberar_trava_instancia; mostrar_erro_e_esperar "Não consegui abrir a pasta $PASTA."; exit 1; }

# Se estiver em terminal interativo e não foi solicitado modo desacoplado, executa no terminal.
# Opção (b): No terminal, iniciamos o servidor e aguardamos o estado aparecer antes de
# liberar a trava atômica. Assim, dois lançamentos rápidos não sobem dois servidores.
# Uma vez gravado o estado (ou após falha/timeout), liberamos a trava e aguardamos o processo
# do servidor em primeiro plano (wait $server_pid) mantendo a sessão interativa vinculada.
if { [ -t 0 ] || [ -t 1 ]; } && [ -z "${ANVILORE_DESACOPLADO:-}" ]; then
  ANVILORE_DESTINO="$PASTA" "$BUN_BIN" src/cli.ts ui &
  server_pid=$!
  for _ in $(seq 1 200); do
    if ! kill -0 "$server_pid" 2>/dev/null; then break; fi
    if estado_pronto_para_servidor "$(obter_caminho_estado)" "$server_pid" "$PASTA"; then break; fi
    sleep 0.1
  done
  liberar_trava_instancia
  wait "$server_pid" 2>/dev/null
  CODIGO=$?
  if [ "$CODIGO" -ne 0 ]; then
    log_file="$(obter_ou_preparar_arquivo_log 2>/dev/null || true)"
    msg_erro="$(montar_mensagem_erro_servidor "$CODIGO" "$log_file")"
    mostrar_erro_e_esperar "$msg_erro"
  fi
  exit "$CODIGO"
fi

# Modo sem terminal: executa desacoplado com setsid/nohup, gravando saída no log
log_file="$(obter_ou_preparar_arquivo_log 2>/dev/null || true)"
if [ -z "$log_file" ]; then
  log_file="/dev/null"
fi

if command -v setsid >/dev/null 2>&1; then
  setsid bash -c '
    exec 9>&-
    set -o pipefail
    ANVILORE_DESTINO="$1" "$2" src/cli.ts ui --auto-encerrar 2>&1 | \
      sed -E "s/token=[a-zA-Z0-9_-]+/token=[REDUZIDO]/g" >>"$3"
  ' _ "$PASTA" "$BUN_BIN" "$log_file" </dev/null &
  server_pid=$!
elif command -v nohup >/dev/null 2>&1; then
  nohup bash -c '
    exec 9>&-
    set -o pipefail
    ANVILORE_DESTINO="$1" "$2" src/cli.ts ui --auto-encerrar 2>&1 | \
      sed -E "s/token=[a-zA-Z0-9_-]+/token=[REDUZIDO]/g" >>"$3"
  ' _ "$PASTA" "$BUN_BIN" "$log_file" </dev/null 2>/dev/null &
  server_pid=$!
else
  (
    exec 9>&-
    set -o pipefail
    ANVILORE_DESTINO="$PASTA" "$BUN_BIN" src/cli.ts ui --auto-encerrar 2>&1 | \
      sed -E 's/token=[a-zA-Z0-9_-]+/token=[REDUZIDO]/g' >>"$log_file"
  ) &
  server_pid=$!
fi

# Aguarda o processo confirmar prontidão (estado gravado), falhar ou timeout de 20s
pronto=0
for _ in $(seq 1 200); do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    wait "$server_pid" 2>/dev/null
    CODIGO=$?
    if [ "$CODIGO" -ne 0 ]; then
      liberar_trava_instancia
      [ -f "$log_file" ] && [ "$log_file" != "/dev/null" ] && cat "$log_file" >&2
      msg_erro="$(montar_mensagem_erro_servidor "$CODIGO" "$log_file")"
      mostrar_erro_e_esperar "$msg_erro"
      exit "$CODIGO"
    fi
    liberar_trava_instancia
    exit 0
  fi
  if estado_pronto_para_servidor "$(obter_caminho_estado)" "$server_pid" "$PASTA"; then
    pronto=1
    break
  fi
  sleep 0.1
done

liberar_trava_instancia
exit 0
